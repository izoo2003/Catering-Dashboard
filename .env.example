# Copy to .env.local. Without GOOGLE_SHEETS_SPREADSHEET_ID the dashboard serves sample data.
# With only the spreadsheet id and a tab gid, the sheet must be shared as
# "Anyone with the link can view". A service account keeps the sheet private.

# The ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# One gid for a single lead tab, or the three call-center tabs below.
GOOGLE_SHEETS_LEADS_GID=
GOOGLE_SHEETS_ENQUIRIES_GID=
GOOGLE_SHEETS_WON_GID=
GOOGLE_SHEETS_LOST_GID=
GOOGLE_SHEETS_SPEND_GID=

# Auth option 1 (recommended): a service account. Share the sheet with its email as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the quotes and the literal \n line breaks from the downloaded JSON key.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Auth option 2: an API key. Only works if the sheet is shared as "Anyone with the link can view".
GOOGLE_SHEETS_API_KEY=

# Lead rows. Header row first; required columns: Inquiry Date, Channel, Initial Status.
# Optional: ID, Client Name, Phone, Quotation Status, Final Outcome, Lost Category,
# Lost Reason Detail, Event Date, Guest Count, Quoted Amount PKR.
GOOGLE_SHEETS_LEADS_RANGE=Leads!A:Z

# Spend rows: a Month column (2026-10 or Oct 2026) or Period Start + Period End,
# plus WhatsApp Ads Spend PKR and Website Spend PKR. Set to empty to skip spend.
GOOGLE_SHEETS_SPEND_RANGE=Spend!A:Z

# How long fetched sheet data is reused before reading Google Sheets again.
LEADS_CACHE_TTL_SECONDS=60
